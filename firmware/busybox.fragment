# Applets added to the vendor busybox config (patch_v2.3/oldconfig/busybox_config) for the test image.
CONFIG_ASH_MATH_SUPPORT=y
CONFIG_APP_UDHCPC=y
CONFIG_FEATURE_UDHCPC_ARPING=y
CONFIG_UDHCPC_DEFAULT_SCRIPT="/etc/udhcpc.script"
CONFIG_HTTPD=y
CONFIG_FEATURE_HTTPD_CGI=y
CONFIG_TELNETD=y
CONFIG_FEATURE_TELNETD_STANDALONE=y
CONFIG_WGET=y
CONFIG_TFTP=y
CONFIG_FEATURE_TFTP_GET=y
CONFIG_FEATURE_TFTP_PUT=y
CONFIG_NC=y
CONFIG_VI=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_HEXDUMP=y
CONFIG_TOP=y
CONFIG_UPTIME=y
CONFIG_DF=y
CONFIG_DU=y
CONFIG_TAIL=y
CONFIG_SED=y
CONFIG_TR=y
CONFIG_WC=y
CONFIG_SYNC=y
CONFIG_UNAME=y
CONFIG_USLEEP=y
CONFIG_SEQ=y
CONFIG_CMP=y
CONFIG_STAT=y
CONFIG_PIDOF=y
CONFIG_FIND=y
CONFIG_AWK=y
CONFIG_WATCH=y
